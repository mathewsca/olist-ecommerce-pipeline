# Copy this file to .env and fill in your own values.
# docker-compose reads .env automatically. NEVER commit your real .env
# (it's already covered by .gitignore) - this file only holds placeholders.

# ---------------------------------------------------------------------------
# Postgres (root credentials for the "postgres" service / Airflow metadata DB)
# ---------------------------------------------------------------------------
# Used to create the "airflow" database (Airflow's own metadata) and, via
# postgres/init/01-init-olist-dw.sh, to create the "olist_dw" database too.
# If you change these, keep DW_USER/DW_PASSWORD below in sync, since the ETL
# connection currently reuses the same root user against olist_dw.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ---------------------------------------------------------------------------
# Olist Data Warehouse (Postgres) - separate database from Airflow's own
# metadata DB, both served by the same "postgres" compose service.
# ---------------------------------------------------------------------------
DW_HOST=postgres
DW_PORT=5432
DW_NAME=olist_dw
DW_USER=airflow
DW_PASSWORD=airflow

# ---------------------------------------------------------------------------
# Airflow secrets
# ---------------------------------------------------------------------------
# Stable Fernet key shared by every Airflow container
# (webserver/scheduler/dag-processor/init) to encrypt Connections/Variables -
# without it, each container generates its own random key and breaks
# previously saved connections on every restart. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Same reasoning as above but for the JWT used between the scheduler/dag-processor
# and the api-server (Task Execution API, Airflow 3+). Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=

# Signing key for Airflow 3's [api] section (AIRFLOW__API__SECRET_KEY). Task
# subprocesses launched by the scheduler authenticate against the api-server's
# Task Execution API using a JWT signed with this key - if it differs between
# containers (or is left empty, so each one falls back to its own random
# default), every component rejects the others' tokens and you'll see:
#   "...have the same 'secret_key' configured in '[api]' section..."
# Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_API_SECRET_KEY=

# The Airflow UI admin password is NOT set via env var here: Airflow 3's
# SimpleAuthManager auto-generates a random password for the "admin" user on
# every webserver container start and prints it to the logs. Retrieve it with:
#   docker compose logs airflow-webserver | grep "Password for user"
# (username is always "admin"). This is fine for local/classroom use; for a
# fixed password you'd need to pre-seed simple_auth_manager_passwords.json.

# ---------------------------------------------------------------------------
# Kaggle API credentials (from https://www.kaggle.com/settings -> API -> Create New Token)
# ---------------------------------------------------------------------------
# Only required for the automated download step; students without these can
# place the Olist CSVs manually in data/raw/ instead.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---------------------------------------------------------------------------
# MLflow (existing, unrelated to the ETL project - left as-is)
# ---------------------------------------------------------------------------
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
